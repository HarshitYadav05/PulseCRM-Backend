{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": "./",
    "paths": {
      "*": ["*", "models/*", "routes/*", "middleware/*", "config/*"]
    }
  },
  "include": ["server.js", "routes/**/*", "models/**/*", "middleware/**/*", "config/**/*"]
}
